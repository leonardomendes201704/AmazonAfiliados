# Variáveis de ambiente do projeto (fonte: docs/arquitetura/visao-geral.md §7).
# Copie para .env e ajuste. Nunca commite o .env. Valores abaixo são só exemplos.

# Nome do projeto no Docker Compose
COMPOSE_PROJECT_NAME=amazonafiliados

# Senha do Postgres (a mesma de infra/compose.dev.yml em dev)
POSTGRES_PASSWORD=postgres

# Conexão com o banco de dev (porta 5433 do compose.dev); o .env não expande variáveis
DATABASE_URL=postgres://postgres:postgres@localhost:5433/amazonafiliados
# Banco usado pelos testes
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/amazonafiliados_test

# URL pública do site (links dos criativos)
PUBLIC_BASE_URL=http://localhost:5173

# Tag de afiliado da Amazon (exemplo fictício)
AMAZON_AFFILIATE_TAG=seutag-20

# Padrão da chave show_price (exibir preço)
SHOW_PRICE_DEFAULT=true
# Idade máxima do preço, em horas, para ele aparecer
PRICE_MAX_AGE_HOURS=24

# Liga ou desliga a coleta
SCRAPE_ENABLED=true
# Agenda da coleta (cron)
SCRAPE_CRON=0 */6 * * *
# Intervalo mínimo e máximo entre requisições, em segundos
SCRAPE_DELAY_MIN_S=20
SCRAPE_DELAY_MAX_S=60
# Quantidade de produtos coletados por categoria
SCRAPE_TOP_N=30
# User-Agent fixo da coleta (navegador comum)
SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# E-mail de login do admin
ADMIN_EMAIL=dono@exemplo.com.br
# Hash argon2 da senha (gere com: pnpm --filter api hash-senha)
ADMIN_PASSWORD_HASH=argon2-hash-aqui
# Segredo da sessão (32+ bytes aleatórios)
SESSION_SECRET=troque-por-32-ou-mais-bytes-aleatorios

# Alertas via Telegram (opcionais; deixe vazio para desativar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Produção: nome da rede do proxy reverso existente na VPS
PROXY_NETWORK=proxy-network-exemplo
# Produção: nome do container web
WEB_CONTAINER_NAME=amazonafiliados-web
# Produção: porta no host (só com compose.hostport.yml)
WEB_PORT=8081
# Produção: tag da imagem (SHA do commit)
IMAGE_TAG=latest

# Backup: quantos backups diários e semanais manter
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
